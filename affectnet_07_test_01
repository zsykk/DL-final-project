,"shell.execute_reply.started":"2026-05-26T18:30:44.740451Z","shell.execute_reply":"2026-05-26T18:30:44.746830Z"}},"outputs":[{"execution_count":6,"output_type":"execute_result","data":{"text/plain":"['angry', 'disgust', 'fear', 'happy', 'sad', 'surprise', 'neutral']"},"metadata":{}}],"execution_count":6},{"id":"40f99b7b-b6a4-4138-8e2d-127d562627de","cell_type":"markdown","source":"## Build Image Table\n\nThis cell first tries class-folder labels. If that fails and CSV files exist, it tries CSV labels.","metadata":{}},{"id":"bdb1f847-8056-4144-8f07-4d1c0ff79fac","cell_type":"code","source":"def normalize_name(value):\n    text = str(value).strip().lower().replace('-', '_').replace(' ', '_')\n    text = text.replace('__', '_')\n    return NAME_ALIASES.get(text, text)\n\ndef infer_label_from_parent(path):\n    for part in reversed(path.parts):\n        name = normalize_name(part)\n        if name in FER_NAME_TO_IDX:\n            return name\n    return None\n\nfolder_rows = []\nfor image_path in image_candidates:\n    label_name = infer_label_from_parent(image_path)\n    if label_name is not None:\n        folder_rows.append({'path': image_path, 'label_name': label_name})\n\nfolder_frame = pd.DataFrame(folder_rows)\nprint('folder-labeled images:', len(folder_frame))\nif not folder_frame.empty:\n    display(folder_frame['label_name'].value_counts().reindex(FER_LABELS).fillna(0).astype(int))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T18:30:44.750096Z","iopub.execute_input":"2026-05-26T18:30:44.750351Z","iopub.status.idle":"2026-05-26T18:30:44.791792Z","shell.execute_reply.started":"2026-05-26T18:30:44.750329Z","shell.execute_reply":"2026-05-26T18:30:44.791201Z"}},"outputs":[{"name":"stdout","text":"folder-labeled images: 5012\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"label_name\nangry       716\ndisgust     716\nfear        716\nhappy       716\nsad         716\nsurprise    716\nneutral     716\nName: count, dtype: int64"},"metadata":{}}],"execution_count":7},{"id":"85440fdc-124a-4997-932d-ef3ccfb24558","cell_type":"code","source":"def infer_columns(frame):\n    lower_to_original = {column.lower(): column for column in frame.columns}\n    image_candidates_names = ['image', 'image_name', 'image_names', 'file', 'filename', 'path', 'image_path', 'subdirectory_file_path']\n    label_candidates_names = ['label', 'emotion', 'expression', 'class', 'target']\n\n    image_column = next((lower_to_original[name] for name in image_candidates_names if name in lower_to_original), None)\n    label_column = next((lower_to_original[name] for name in label_candidates_names if name in lower_to_original), None)\n\n    if image_column is None:\n        image_column = frame.columns[0]\n    if label_column is None:\n        label_column = frame.columns[1]\n    return image_column, label_column\n\nimage_lookup = {path.name: path for path in image_candidates}\nimage_lookup.update({path.as_posix(): path for path in image_candidates})\n\ndef resolve_image_path(value):\n    value = str(value)\n    candidate = Path(value)\n    if candidate.is_absolute() and candidate.exists():\n        return candidate\n    direct = AFFECTNET_ROOT / value\n    if direct.exists():\n        return direct\n    if value in image_lookup:\n        return image_lookup[value]\n    if candidate.name in image_lookup:\n        return image_lookup[candidate.name]\n    raise FileNotFoundError(f'Could not resolve image path for {value}')\n\ndef label_value_to_name(value):\n    if pd.isna(value):\n        return None\n    text = str(value).strip()\n    if text.lstrip('-').isdigit():\n        return COMMON_AFFECTNET_ID_TO_NAME.get(int(text))\n    name = normalize_name(text)\n    return name if name in FER_NAME_TO_IDX else None\n\ncsv_frame = pd.DataFrame()\nif csv_candidates:\n    frames = []\n    for csv_path in csv_candidates:\n        frame = pd.read_csv(csv_path)\n        image_column, label_column = infer_columns(frame)\n        temp = frame[[image_column, label_column]].copy()\n        temp.columns = ['image_value', 'label_value']\n        temp['source_csv'] = str(csv_path)\n        frames.append(temp)\n    raw_csv_frame = pd.concat(frames, ignore_index=True)\n    raw_csv_frame['path'] = raw_csv_frame['image_value'].apply(resolve_image_path)\n    raw_csv_frame['label_name'] = raw_csv_frame['label_value'].apply(label_value_to_name)\n    csv_frame = raw_csv_frame.dropna(subset=['label_name']).copy()\n\nprint('csv-labeled images:', len(csv_frame))\nif not csv_frame.empty:\n    display(csv_frame['label_name'].value_counts().reindex(FER_LABELS).fillna(0).astype(int))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T18:30:44.792503Z","iopub.execute_input":"2026-05-26T18:30:44.792831Z","iopub.status.idle":"2026-05-26T18:30:44.809196Z","shell.execute_reply.started":"2026-05-26T18:30:44.792790Z","shell.execute_reply":"2026-05-26T18:30:44.808571Z"}},"outputs":[{"name":"stdout","text":"csv-labeled images: 0\n","output_type":"stream"}],"execution_count":8},{"id":"b8d6cf1b-8701-4032-8bd1-d8a95d730d56","cell_type":"code","source":"if not folder_frame.empty:\n    affectnet_frame = folder_frame.copy()\n    label_source = 'class_folder_names'\nelif not csv_frame.empty:\n    affectnet_frame = csv_frame[['path', 'label_name']].copy()\n    label_source = 'csv_labels'\nelse:\n    raise ValueError('Could not infer AffectNet-7 labels from folders or CSV files.')\n\naffectnet_frame['fer_label'] = affectnet_frame['label_name'].map(FER_NAME_TO_IDX).astype(int)\naffectnet_frame = affectnet_frame.reset_index(drop=True)\n\nprint('label source:', label_source)\nprint('samples:', len(affectnet_frame))\ndisplay(affectnet_frame['label_name'].value_counts().reindex(FER_LABELS).fillna(0).astype(int))\ndisplay(affectnet_frame.head())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-26T18:30:44.810153Z","iopub.execute_input":"2026-05-26T18:30:44.810817Z","iopub.status.idle